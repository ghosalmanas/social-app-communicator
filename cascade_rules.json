        "application",
        "verification"
      ],
      "required_approvals": 2,
      "auto_apply_threshold": 0.8
    },
    "validation": {
      "code_quality": true,
      "build_impact": true,
      "test_coverage": true,
      "security": true,
      "performance": true,
      "maintainability": true
    }
  }
}
