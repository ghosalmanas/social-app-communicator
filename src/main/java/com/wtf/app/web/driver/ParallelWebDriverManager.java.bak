    /**
     * Clean up all WebDriver instances.
     */
    /**
     * Checks if there's enough disk space available.
     * @return true if there's enough space, false otherwise
     */
    /**
     * Gets the available disk space for a given path
     * @param path The path to check disk space for
     * @return Available space in bytes
     */
    private long getAvailableSpace(String path) {
        try {
            File disk = new File(path);
            return disk.getUsableSpace();
        } catch (Exception e) {
            logger.error("Error checking disk space for path: " + path, e);
            return -1;
        }
    }
    
    /**
     * Checks if there's enough disk space available on both C: drive and profile directory
     * @return true if there's enough space, false otherwise
     */
    /**
     * Attempts to free up disk space by cleaning the Recycle Bin and old profiles
     * @return true if space was successfully freed, false otherwise
     */
    private boolean tryFreeUpSpace() {
        logger.info("Attempting to free up disk space...");
        
        // 1. First try to clean up old profiles
        int cleanedProfiles = cleanupOldProfiles();
        logger.info("Cleaned up {} old profiles", cleanedProfiles);
        
        // 2. Clean up browser caches
        int cleanedCache = cleanUpCache(new File(profileBaseDir));
        logger.info("Cleaned up {} cache items", cleanedCache);
        
        // 3. Clean up temp files
        try {
            File tempDir = new File(System.getProperty("java.io.tmpdir"));
            int tempFiles = cleanUpDirectory(tempDir, 7); // Clean files older than 7 days
            logger.info("Cleaned up {} temporary files", tempFiles);
        } catch (Exception e) {
            logger.warn("Error cleaning temp files: {}", e.getMessage());
        }
        
        // 4. Final check
        long availableSpace = getAvailableSpace(profileBaseDir);
        boolean hasEnoughSpace = availableSpace >= MIN_DISK_SPACE_BYTES;
        
        if (hasEnoughSpace) {
            logger.info("Successfully freed up disk space. Now available: {}MB", 
                availableSpace / (1024 * 1024));
        } else {
            logger.warn("Could not free up enough disk space. Available: {}MB, Required: {}MB",
                availableSpace / (1024 * 1024), MIN_DISK_SPACE_BYTES / (1024 * 1024));
        }
        
        return hasEnoughSpace;
    }
    
    private synchronized boolean hasEnoughDiskSpace() {
        long now = System.currentTimeMillis();
        // Only check disk space once per interval to avoid performance issues
        if (now - lastDiskSpaceCheck < DISK_SPACE_CHECK_INTERVAL_MS && lastFreeSpace > 0) {
            return lastFreeSpace >= MIN_DISK_SPACE_BYTES;
        }
        
        lastDiskSpaceCheck = now;
        
        // Check C: drive space
        long cDriveSpace = getAvailableSpace("C:\\");
        if (cDriveSpace < MIN_DISK_SPACE_BYTES) {
            logger.warn("Low disk space on C: drive: {}MB available (minimum required: {}MB)", 
                cDriveSpace / (1024 * 1024), MIN_DISK_SPACE_BYTES / (1024 * 1024));
            
            // Try to free up space automatically
            if (tryFreeUpSpace()) {
                // Check again after cleanup
                cDriveSpace = getAvailableSpace("C:\\");
                if (cDriveSpace >= MIN_DISK_SPACE_BYTES) {
                    logger.info("Successfully freed up enough space on C: drive");
                    lastFreeSpace = cDriveSpace;
                    return true;
                }
            }
            return false;
        }
        
        // Check profile directory space (in case it's on a different drive)
        lastFreeSpace = getAvailableSpace(profileBaseDir);
        if (lastFreeSpace < MIN_DISK_SPACE_BYTES) {
            logger.warn("Low disk space in profile directory ({}): {}MB available (minimum required: {}MB)", 
                profileBaseDir, lastFreeSpace / (1024 * 1024), MIN_DISK_SPACE_BYTES / (1024 * 1024));
            
            // Try to free up space automatically
            if (tryFreeUpSpace()) {
                // Check again after cleanup
                lastFreeSpace = getAvailableSpace(profileBaseDir);
                if (lastFreeSpace >= MIN_DISK_SPACE_BYTES) {
                    logger.info("Successfully freed up enough space in profile directory");
                    return true;
                }
            }
            return false;
        }
        
        return true;
    }
    
    /**
     * Cleans up old profiles and cache to free up disk space.
     * @return number of items cleaned up
     */
    /**
     * Cleans up cache directories and files to free up disk space.
     * @param directory The directory to clean up cache from
     * @return number of cache items cleaned up
     */
    private int cleanUpCache(File directory) {
        return cleanUpDirectory(directory, 0); // Clean all cache files regardless of age
    }
    
    private int cleanUpDirectory(File directory, int maxAgeDays) {
        if (!directory.exists() || !directory.isDirectory()) {
            return 0;
        }
        
        int cleanedCount = 0;
        long cutoffTime = System.currentTimeMillis() - (maxAgeDays * 24 * 60 * 60 * 1000L);
        File[] files = directory.listFiles();
        
        if (files == null) {
            return 0;
        }
        
        for (File file : files) {
            try {
                // Skip files that are too new or in use
                if (maxAgeDays > 0 && file.lastModified() > cutoffTime) {
                    continue;
                }
                
                if (file.isDirectory()) {
                    // Recursively clean subdirectories
                    cleanedCount += cleanUpDirectory(file, maxAgeDays);
                    
                    // Delete the directory if it's empty
                    String[] children = file.list();
                    if (children != null && children.length == 0) {
                        if (file.delete()) {
                            cleanedCount++;
                        }
                    }
                } else {
                    // Delete cache and temporary files
                    String name = file.getName().toLowerCase();
                    if (name.contains("cache") || 
                        name.endsWith(".tmp") || 
                        name.endsWith(".temp") ||
                        name.endsWith(".log") ||
                        name.endsWith(".old") ||
                        name.endsWith(".bak") ||
                        name.startsWith("temp") ||
                        name.startsWith("tmp")) {
                        
                        if (file.delete()) {
                            cleanedCount++;
                        }
                    }
                }
            } catch (Exception e) {
                logger.warn("Error cleaning file {}: {}", file.getAbsolutePath(), e.getMessage());
            }
        }
        
        return cleanedCount;
    }
    
    /**
     * Cleans up old profiles and cache to free up disk space.
     * @return number of items cleaned up
     */
    private int cleanupOldProfiles() {
        return cleanupOldProfiles(false);
    }
    
    private int cleanupOldProfiles(boolean forceCleanup) {
        File profileDir = new File(profileBaseDir);
        if (!profileDir.exists() || !profileDir.isDirectory()) {
            return 0;
        }

        File[] profileDirs = profileDir.listFiles(File::isDirectory);
        if (profileDirs == null || profileDirs.length == 0) {
            return 0;
        }

        // Sort by last modified time, oldest first
        Arrays.sort(profileDirs, Comparator.comparingLong(File::lastModified));

        int deletedCount = 0;
        long currentTime = System.currentTimeMillis();
        long maxAgeMs = MAX_PROFILE_AGE_MINUTES * 60 * 1000L;
        int activeProfiles = profileDriverMap.size();

        for (File profile : profileDirs) {
            try {
                // Skip if this is the current profile being used
                if (isProfileInUse(profile.getName())) {
                    continue;
                }

                boolean isOld = (currentTime - profile.lastModified()) > maxAgeMs;
                boolean isOverLimit = (profileDirs.length - deletedCount) > MAX_PROFILES_TO_KEEP;

                if (forceCleanup || isOld || isOverLimit) {
                    logger.info("Attempting to delete profile: {}", profile.getAbsolutePath());
                    if (deleteDirectory(profile)) {
                        deletedCount++;
                        logger.info("Successfully deleted old profile: {}", profile.getName());
                    } else {
                        logger.warn("Failed to delete profile directory: {}", profile.getAbsolutePath());
                    }
                }
            } catch (Exception e) {
                logger.error("Error processing profile for cleanup: {}", profile.getAbsolutePath(), e);
            }
        }

        if (deletedCount > 0) {
            logger.info("Cleaned up {} old profile directories", deletedCount);
        }

        return deletedCount;
    }

    private boolean deleteDirectory(File directoryToBeDeleted) {
        File[] allContents = directoryToBeDeleted.listFiles();
        if (allContents != null) {
            for (File file : allContents) {
                deleteDirectory(file);
            }
        }
        return directoryToBeDeleted.delete();
    }

    /**
     * Checks if a profile is currently in use by any active WebDriver.
     */
    private boolean isProfileInUse(String profileName) {
        return profileDriverMap.keySet().stream()
            .anyMatch(key -> key.name().startsWith(profileName));
    }
    
    @Scheduled(fixedRate = 30 * 60 * 1000) // Run every 30 minutes
    public void scheduleProfileCleanup() {
        try {
            logger.info("Running scheduled profile cleanup");
            cleanupOldProfiles();
        } catch (Exception e) {
            logger.error("Error during scheduled profile cleanup", e);
        }
    }

    @PreDestroy
    public void cleanup() {
        logger.info("Shutting down ParallelWebDriverManager");
        // Cleanup all drivers and profiles
        profileDriverMap.forEach((profile, driver) -> closeDriverSafely(profile, driver));
        profileDriverMap.clear();
        currentDriverInThreadLocal.remove();
        
        // Cleanup session keep-alive if available
        if (sessionKeepAlive != null) {
            sessionKeepAlive.cleanup();
        }

        // Clean up all drivers, removing duplicates
        Set<WebDriver> uniqueDrivers = new HashSet<>(driverMap.values());
        driverMap.clear();

        uniqueDrivers.forEach(driver -> {
            try {
                if (driver != null) {
                    driver.quit();
                }
            } catch (Exception e) {
                logger.error("Error cleaning up WebDriver", e);
            }
        });
        logger.info("WebDriver cleanup completed");
    }
    
    /**
     * Safely closes a WebDriver instance and removes it from the profile map.
     */
    /**
     * Safely closes a WebDriver instance and removes it from the profile map.
    // * @param profileName The name of the profile to close
     * @param driver The WebDriver instance to close
     */
    private void closeDriverSafely(TaskType taskType, WebDriver driver) {
        String profileName = taskType.name();
        if (driver != null) {
            try {
                logger.info("Closing WebDriver for profile: {}", profileName);
                driver.quit();
            } catch (Exception e) {
                logger.error("Error closing WebDriver for profile: " + profileName, e);
            } finally {
                profileDriverMap.remove(taskType);
                
                // Clean up the profile directory if it exists
                try {
                    File profileDir = new File(profileBaseDir, profileName);
                    if (profileDir.exists()) {
                        FileUtils.deleteDirectory(profileDir);
                        logger.debug("Deleted profile directory: {}", profileDir);
                    }
                } catch (Exception e) {
                    logger.error("Error cleaning up profile directory for: " + profileName, e);
                }
            }
        }
    }
    
    /**
     * Safely quit a WebDriver instance, ensuring all resources are cleaned up.
     * Handles various edge cases and logs detailed information.
     * @param driver The WebDriver instance to quit
     */
    /**
     * Cleans up any running Chrome and ChromeDriver processes.
     * This is a last resort when normal WebDriver cleanup fails.
     */
    private void cleanupChromeProcesses() {
        logger.info("Cleaning up Chrome processes...");
        try {
            if (System.getProperty("os.name").toLowerCase().contains("win")) {
                // Windows
                Runtime.getRuntime().exec("taskkill /F /IM chrome.exe");
                Runtime.getRuntime().exec("taskkill /F /IM chromedriver.exe");
                Runtime.getRuntime().exec("taskkill /F /IM chrome_proxy.exe");
            } else {
                // Unix/Linux/Mac
                Runtime.getRuntime().exec("pkill -f chrome");
                Runtime.getRuntime().exec("pkill -f chromedriver");
            }
            // Give some time for processes to terminate
            Thread.sleep(2000);
        } catch (Exception e) {
            logger.warn("Error during Chrome process cleanup: {}", e.getMessage());
        }
    }
    
    private void safeQuitDriver(WebDriver driver) {
        if (driver == null) {
            return;
        }
        
        String sessionId = "unknown";
        try {
            if (driver instanceof RemoteWebDriver) {
                SessionId id = ((RemoteWebDriver) driver).getSessionId();
                if (id != null) {
                    sessionId = id.toString();
                }
            }
            
            logger.info("Attempting to quit WebDriver session: {}", sessionId);
            
            // Try to close all windows first
            try {
                for (String handle : driver.getWindowHandles()) {
                    try {
                        driver.switchTo().window(handle);
                        driver.close();
                        logger.debug("Closed window: {}", handle);
                        Thread.sleep(100); // Small delay between window closes
                    } catch (Exception e) {
                        logger.debug("Error closing window {}: {}", handle, e.getMessage());
                    }
                }
            } catch (Exception e) {
                logger.debug("Error while closing windows: {}", e.getMessage());
            }
            
            // Then quit the driver
            try {
                driver.quit();
                logger.info("Successfully quit WebDriver session: {}", sessionId);
            } catch (Exception e) {
                logger.warn("Error during driver.quit() for session {}: {}", sessionId, e.getMessage());
                // Try to kill the process if possible
                if (e.getMessage() != null && e.getMessage().contains("failed to kill")) {
                    logger.warn("Attempting to forcefully terminate the browser process...");
                    try {
                        if (System.getProperty("os.name").toLowerCase().contains("win")) {
                            Runtime.getRuntime().exec("taskkill /F /IM chrome.exe");
                        } else {
                            Runtime.getRuntime().exec("pkill -f chrome");
                        }
                        logger.info("Browser process terminated");
                    } catch (Exception ex) {
                        logger.error("Failed to terminate browser process: {}", ex.getMessage());
                    }
                }
            }
            
        } catch (Exception e) {
            logger.error("Unexpected error while quitting WebDriver (session: {}): {}", 
                sessionId, e.getMessage(), e);
        } finally {
            // Ensure driver reference is cleared
            try {
                driver = null;
            } catch (Exception e) {
                // Ignore any errors during cleanup
            }
        }
    }
    
    /**
     * Helper method to detect if an exception is related to WebSocket/connection issues.
     * @param e The exception to check
     * @return true if the exception is connection-related
     */
    private boolean isConnectionError(WebDriverException e) {
        if (e == null) return false;
        
        String errorMessage = e.getMessage();
        if (errorMessage == null) return false;
        
        // Common connection-related error messages
        return errorMessage.contains("Connection reset") ||
               errorMessage.contains("chrome not reachable") ||
               errorMessage.contains("session deleted because of page crash") ||
               errorMessage.contains("disconnected: unable to connect to renderer") ||
               errorMessage.contains("no such session") ||
               errorMessage.contains("target window already closed") ||
               errorMessage.contains("chrome not reachable");
    }
    
    /**
     * Check if a WebDriver session is active and responsive.
     * Performs multiple checks to ensure the session is truly active.
     * 
     * @param driver The WebDriver instance to check
     * @return true if the session is active and responsive, false otherwise
     */
    public boolean isSessionActive(WebDriver driver) {
        if (driver == null) {
            logger.debug("WebDriver is null, session is not active");
            return false;
        }
        
        try {
            // 1. Basic session check with timeout
            Timeouts timeouts = driver.manage().timeouts();
            Duration originalImplicitWait = timeouts.getImplicitWaitTimeout();
            
            try {
                // Set a short timeout for the check
                timeouts.implicitlyWait(Duration.ofSeconds(2));
                
                // 1.1 Check if we can get the current URL (basic session check)
                String currentUrl = driver.getCurrentUrl();
                if (currentUrl == null || currentUrl.trim().isEmpty() || currentUrl.startsWith("data:")) {
                    logger.debug("Invalid or empty URL detected: {}", currentUrl);
                    return false;
                }
                
                // 1.2 Check if the window handle is valid
                try {
                    driver.getWindowHandle();
                } catch (NoSuchWindowException e) {
                    logger.debug("No window handle found, session is not active");
                    return false;
                }
                
                // 1.3 Check if the session ID is still valid for RemoteWebDriver
                if (driver instanceof RemoteWebDriver) {
                    try {
                        ((RemoteWebDriver) driver).getSessionId();
                    } catch (Exception e) {
                        logger.debug("Invalid session ID: {}", e.getMessage());
                        return false;
                    }
                }
                
                // 2. Check JavaScript execution capability
                try {
                    // First check document.readyState
                    boolean isDocumentReady = (boolean) ((JavascriptExecutor) driver).executeScript(
                        "return document.readyState === 'complete'");
                    
                    // Additional check with navigator.userAgent
                    Object userAgent = ((JavascriptExecutor) driver).executeScript("return navigator.userAgent");
                    if (userAgent == null) {
                        logger.debug("JavaScript execution returned null userAgent");
                        return false;
                    }
                    
                    // 3. Check window handles count
                    int windowCount = driver.getWindowHandles().size();
                    if (windowCount == 0) {
                        logger.debug("No windows/tabs found in the browser");
                        return false;
                    }
                    
                    return isDocumentReady;
                    
                } catch (JavascriptException e) {
                    logger.debug("JavaScript execution failed: {}", e.getMessage());
                    // If we can execute JS but get an error, the session is still active
                    return true;
                } catch (UnreachableBrowserException e) {
                    logger.error("Browser is unreachable: {}", e.getMessage());
                    return false;
                } catch (WebDriverException e) {
                    logger.error("WebDriver error during JavaScript execution: {}", e.getMessage());
                    return false;
                }
                
            } finally {
                // Restore original timeout
                try {
                    timeouts.implicitlyWait(originalImplicitWait);
                } catch (Exception e) {
                    logger.warn("Failed to restore original implicit wait: {}", e.getMessage());
                }
            }
            
        } catch (WebDriverException e) {
            if (isConnectionError(e)) {
                logger.debug("WebSocket connection error in session validation: {}", e.getMessage());
            } else {
                logger.debug("WebDriver exception during session validation: {}", e.getMessage());
            }
            return false;
        } catch (Exception e) {
            logger.debug("Unexpected exception during session validation: {}", e.getMessage());
            return false;
        }
    }

    public WebDriver createDriver(TaskType taskType) {
        logger.info("Creating WebDriver for profile from calling method: {}: {}", Thread.currentThread().getName(), taskType.name());
        return getDriver(taskType);
    }

    public JavascriptExecutor getJsExecutor(TaskType taskType) {
        logger.info("Getting JavascriptExecutor for profile from calling method: {}: {}", Thread.currentThread().getName(), taskType.name());
        WebDriver driver = getDriver(taskType);
        if (driver instanceof JavascriptExecutor) {
            return (JavascriptExecutor) driver;
        }
        throw new IllegalStateException("WebDriver instance is not a JavascriptExecutor");
    }

    public ConcurrentMap<TaskType, WebDriver> getProfileDriverMap() {
        return profileDriverMap;
    }

    public ConcurrentMap<TaskType, WebDriver> updateProfileDriverEntry(TaskType taskType, WebDriver driver) {
        profileDriverMap.put(taskType, driver);
        return profileDriverMap;
    }
}
