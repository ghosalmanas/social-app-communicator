     * Get the WebDriver for the current thread's active profile.
     */
    public WebDriver getCurrentDriver() {

        /*String taskType = currentProfile.get();
        if (taskType == null) {*/

        logger.info("Getting WebDriver for current thread {} {}", Thread.currentThread().getName(), ThreadLocalAutomationContext.getContext().getTaskType());

        if(currentDriverInThreadLocal.get()!=null){
