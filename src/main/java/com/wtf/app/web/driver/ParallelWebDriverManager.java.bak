            profileDriverMap.put(ThreadLocalAutomationContext.getContext().getTaskType(), ThreadLocalAutomationContext.getContext().getDriver());
            return currentDriverInThreadLocal.get();
        }
                return driver;
            } else {
                logger.info("Existing WebDriver for task {} is no longer active, creating a new one", taskType);
                safeQuitDriver(driver);
            }

        logger.info("Setting WebDriver for current thread {} {}", webDriver.getCurrentUrl(), ThreadLocalAutomationContext.getContext().getDriver().getCurrentUrl());
        currentDriverInThreadLocal.set(webDriver);
        ThreadLocalAutomationContext.getContext().setDriver(webDriver);
        logger.info("Verifying and returning WebDriver for current thread {} {}", webDriver.getCurrentUrl(), ThreadLocalAutomationContext.getContext().getDriver().getCurrentUrl());

        try {
            // Check if the driver is still valid
            webDriver.getCurrentUrl(); // This will throw if driver is invalid
            return webDriver;
        } catch (Exception e) {
            logger.warn("Existing WebDriver session is invalid, creating new one", e);
            profileDriverMap.remove(taskType);
            return getDriver(taskType);
        }
    }
    
    /**
     * Create a new WebDriver instance with the specified profile.
     * Implements retry logic and session validation.
     */
    /**
     * Creates a new WebDriver instance with the specified profile.
     * Implements retry logic, session validation, and resource management.
     */
    private WebDriver createWebDriver(String profileName) {
        // Check resource constraints before proceeding
        if (profileDriverMap.size() >= MAX_CONCURRENT_DRIVERS) {
            throw new IllegalStateException(
                String.format("Maximum number of concurrent WebDrivers (%d) reached", MAX_CONCURRENT_DRIVERS));
        }
        
        ensureProfileDirectory();  // Check disk space and clean up if needed
        
        ChromeOptions options = new ChromeOptions();
        WebDriver driver = null;
        int attempt = 0;
        Exception lastError = null;
        long currentRetryDelay = retryDelayMs;

        while (attempt < maxRetryAttempts) {
            attempt++;
            logger.info("Attempt {}/{} to create WebDriver for profile: {}", attempt, maxRetryAttempts, profileName);
            
            try {
                // Create a unique profile directory for this session
                String profilePath = createUniqueProfileDirectory(profileName);
                options.addArguments("--user-data-dir=" + profilePath);
                
                // Configure Chrome options with security and performance optimizations
                if (headless) {
                    options.addArguments("--headless=new");
                }
                
                // Create cache and storage directories
                String cacheDir = profilePath + File.separator + "cache";
                new File(cacheDir).mkdirs();
                
                options.addArguments(
                    "--disable-gpu",
                    "--no-sandbox",
                    "--disable-dev-shm-usage",
                    "--remote-allow-origins=*",
                    "--disable-extensions",
                    "--disable-software-rasterizer",
                    "--disable-notifications",
                    "--disable-popup-blocking",
                    "--disable-infobars",
                    "--ignore-certificate-errors",
                    "--disable-web-resource",
                    "--disable-translate",
                    "--safebrowsing-disable-download-protection",
                    "--safebrowsing-disable-extension-blacklist",
                    "--start-maximized",
                    "--disable-application-cache",
                    "--media-cache-size=1",
                    "--disk-cache-size=104857600",  // 100MB cache limit
                    "--disk-cache-dir=" + cacheDir,
                    "--disable-background-networking",
                    "--disable-client-side-phishing-detection",
                    "--disable-component-update",
                    "--disable-default-apps",
                    "--disable-hang-monitor",
                    "--disable-prompt-on-repost",
                    "--disable-sync",
                    "--metrics-recording-only",
                    "--no-first-run",
                    "--safebrowsing-disable-auto-update",
                    "--password-store=basic",
                    "--use-mock-keychain"
                );
                
                // Disable various background services that consume disk space
                Map<String, Object> prefs = new HashMap<>();
                prefs.put("profile.default_content_setting_values.notifications", 2);
                prefs.put("credentials_enable_service", false);
                prefs.put("profile.password_manager_enabled", false);
                prefs.put("profile.default_content_settings.popups", 0);
                prefs.put("download_restrictions", 3);
                prefs.put("safebrowsing.enabled", false);
                prefs.put("safebrowsing.malware.enabled", false);
                prefs.put("safebrowsing.disable_proxy", true);
                options.setExperimentalOption("prefs", prefs);

                options.addArguments("--lang=en-US");

                if (headless) {
                    options.addArguments("--headless=new");
                }
                
                // Add any additional Chrome arguments from configuration
                if (chromeArgs != null && chromeArgs.length > 0) {
                    options.addArguments(chromeArgs);
                }
                
                // Set experimental options
                /*if (!experimentalOptions.isEmpty()) {
                    experimentalOptions.forEach(options::setExperimentalOption);
                }*/

                // Set page load strategy
                options.setPageLoadStrategy(PageLoadStrategy.NORMAL);

                // Disable automation flags
                options.setExperimentalOption("excludeSwitches",
                    Arrays.asList("enable-automation", "load-extension"));
                options.setExperimentalOption("useAutomationExtension", false);

                // Set logging preferences
                LoggingPreferences logPrefs = new LoggingPreferences();
                logPrefs.enable(LogType.BROWSER, Level.SEVERE);
                logPrefs.enable(LogType.DRIVER, Level.WARNING);
                options.setCapability("goog:loggingPrefs", logPrefs);

                // Create ChromeDriverService with logging
                ChromeDriverService service = new ChromeDriverService.Builder()
                    .withLogOutput(System.out)
                    .withSilent(false)
                    .build();

                // Create the WebDriver instance with enhanced error handling
                logger.info("Creating ChromeDriver instance for profile: {}", profileName);
                driver = new ChromeDriver(service, options);

                // Configure timeouts
                configureDriverTimeouts(driver);

                // Validate the session
                if (isSessionActive(driver)) {
                    logger.info("Successfully created and validated WebDriver for profile: {}", profileName);
                    return driver;
                } else {
                    logger.warn("WebDriver session validation failed for profile: {}", profileName);
                    safeQuitDriver(driver);
                    driver = null;
                }
                
            } catch (Exception e) {
                logger.error("Error creating WebDriver for profile {}: {}", profileName, e.getMessage(), e);
                safeQuitDriver(driver);
                driver = null;
                lastError = e;
                
                // Wait before retrying if this wasn't the last attempt
                if (attempt < maxRetryAttempts) {
                    try {
                        logger.info("Waiting {}ms before retry...", currentRetryDelay);
                        Thread.sleep(currentRetryDelay);
                        // Exponential backoff for next retry
                        currentRetryDelay *= 2;
                    } catch (InterruptedException ie) {
                        Thread.currentThread().interrupt();
                        throw new RuntimeException("Thread interrupted while waiting to retry WebDriver creation", ie);
                    }
                }
            }
        }
        
        // If we get here, all attempts failed
        String errorMsg = String.format("Failed to create WebDriver after %d attempts for profile: %s. Last error: %s", 
            maxRetryAttempts, profileName, lastError != null ? lastError.getMessage() : "Unknown error");
            
        // Log detailed error information
        logger.error(errorMsg);
        logger.error("Profile directory: {}", profileToPathMap.get(profileName));
        logger.error("Chrome version: {}", getChromeVersion());
        logger.error("ChromeDriver version: {}", getChromeDriverVersion());
        
        // Provide troubleshooting suggestions
        logger.error("\nTroubleshooting steps:" +
                   "\n1. Make sure Chrome is installed and up to date" +
                   "\n2. Verify ChromeDriver version matches your Chrome browser version" +
                   "\n3. Check if Chrome is already running (try closing all Chrome instances)" +
                   "\n4. Try running with a clean profile directory" +
                   "\n5. Check for system resource constraints (CPU, memory, disk space)" +
                   "\n6. Verify Chrome has necessary permissions to run");
        
        throw new RuntimeException(errorMsg, lastError);
    }
    
    private String getChromeVersion() {
        try {
            Process process = new ProcessBuilder(
                System.getProperty("webdriver.chrome.binary", "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"),
                "--version"
            ).start();
            
            try (BufferedReader reader = new BufferedReader(new InputStreamReader(process.getInputStream()))) {
                return reader.lines().findFirst().orElse("Unknown");
            }
        } catch (Exception e) {
            logger.warn("Failed to get Chrome version: {}", e.getMessage());
            return "Unknown";
        }
    }
    
    private String getChromeDriverVersion() {
        try {
            String driverPath = System.getProperty("webdriver.chrome.driver");
            if (driverPath == null || driverPath.isEmpty()) {
                return "Not specified (using WebDriverManager)";
            }
            
            Process process = new ProcessBuilder(driverPath, "--version").start();
            try (BufferedReader reader = new BufferedReader(new InputStreamReader(process.getErrorStream()))) {
                return reader.lines()
                    .filter(line -> line.startsWith("ChromeDriver"))
                    .findFirst()
                    .orElse("Unknown");
            }
        } catch (Exception e) {
            logger.warn("Failed to get ChromeDriver version: {}", e.getMessage());
            return "Unknown";
        }
    }
    
    private void configureWebDriverManager() {
        try {
            logger.info("Configuring WebDriverManager for Chrome");
            
            // Setup WebDriverManager for Chrome
            WebDriverManager chromeDriverManager = WebDriverManager.chromedriver();
            
            // Set ChromeDriver version based on configuration or auto-detect
            if (chromeVersion != null && !chromeVersion.isEmpty() && !"latest".equalsIgnoreCase(chromeVersion)) {
                logger.info("Using specified ChromeDriver version: {}", chromeVersion);
                chromeDriverManager.driverVersion(chromeVersion);
            } else {
                logger.info("Using latest ChromeDriver version");
            }
            
            // Configure WebDriverManager settings
            chromeDriverManager.setup();
            
            // Log the resolved ChromeDriver version
            String resolvedVersion = chromeDriverManager.getDownloadedDriverVersion();
            logger.info("Resolved ChromeDriver version: {}", resolvedVersion);
            
            // Set system properties for ChromeDriver
            System.setProperty("webdriver.chrome.silentOutput", "true");
            
            // Additional ChromeDriver options for better stability
            System.setProperty("webdriver.chrome.verboseLogging", "false");
            System.setProperty("webdriver.chrome.silentOutput", "true");
            
            // Disable ChromeDriver logging to console
            java.util.logging.Logger.getLogger("org.openqa.selenium").setLevel(Level.SEVERE);
            
            logger.info("WebDriverManager configuration completed successfully");
        } catch (Exception e) {
            logger.error("Error configuring WebDriverManager", e);
            throw new RuntimeException("Failed to configure WebDriverManager", e);
        }
    }
    
    /**
     * Configures Chrome options with common settings for automation.
     */
    private ChromeOptions configureChromeOptions(String profileName) {
        ChromeOptions options = new ChromeOptions();
        
        // Set user data directory for profile persistence
        String profileDir = createUniqueProfileDirectory(profileName);
        options.addArguments("--user-data-dir=" + profileDir);
        
        // Set page load strategy
        options.setPageLoadStrategy(PageLoadStrategy.NORMAL);
        
        // Disable automation flags and extensions
        options.setExperimentalOption("excludeSwitches", 
            Arrays.asList("enable-automation", "load-extension"));
        options.setExperimentalOption("useAutomationExtension", false);
        
        // Set logging preferences
        LoggingPreferences logPrefs = new LoggingPreferences();
        logPrefs.enable(LogType.BROWSER, Level.SEVERE);
        logPrefs.enable(LogType.DRIVER, Level.WARNING);
        options.setCapability("goog:loggingPrefs", logPrefs);
        
        // Add common arguments
        options.addArguments(
            "--start-maximized",
            "--window-size=1920,1080",
            "--disable-blink-features=AutomationControlled",
            "--disable-notifications",
            "--no-sandbox",
            "--disable-dev-shm-usage"
        );
        
        return options;
    }
    
    /**
     * Creates and configures ChromeDriverService with proper logging.
     */
    private ChromeDriverService createChromeDriverService() {
        try {
            return new ChromeDriverService.Builder()
                .withLogOutput(System.out)
                .withSilent(false)
                .withLogFile(createLogFile("chromedriver"))
                .build();
        } catch (IOException e) {
            logger.warn("Failed to create ChromeDriverService with log file, falling back to default", e);
            return new ChromeDriverService.Builder().build();
        }
    }
    
    /**
     * Creates a log file with timestamp for better debugging.
     */
    private File createLogFile(String prefix) throws IOException {
        String timestamp = LocalDateTime.now().format(DateTimeFormatter.ofPattern("yyyyMMdd_HHmmss"));
        String logFileName = String.format("%s_%s.log", prefix, timestamp);
        File logFile = new File("logs", logFileName);
        Files.createDirectories(logFile.getParentFile().toPath());
        return logFile;
    }
    
    private void configureDriverTimeouts(WebDriver driver) {
        try {
            driver.manage().timeouts().pageLoadTimeout(Duration.ofSeconds(pageLoadTimeout));
            driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(implicitWait));
            logger.debug("Configured timeouts - PageLoad: {}s, Implicit: {}s", 
                pageLoadTimeout, implicitWait);
        } catch (Exception e) {
            logger.error("Failed to configure driver timeouts: {}", e.getMessage(), e);
            throw e;
        }
