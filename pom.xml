	<groupId>com.wtf</groupId>
	<artifactId>WA_TG_FB_SeleniumFreelancerAppV2</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>WA_TG_FB_SeleniumFreelancerAppV2</name>
	<description>Spring Boot Freelancing App for injection in runtime via api</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	
	
	<properties>
    <java.version>21</java.version>
    <spring-ai.version>1.0.0</spring-ai.version>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <selenium.version>4.11.0</selenium.version>
    <httpclient5.version>5.2.1</httpclient5.version>
    <webdrivermanager.version>5.5.3</webdrivermanager.version>
    <argLine>-Xmx4096m -Xms2048m -XX:MaxMetaspaceSize=512m --enable-preview</argLine>
    <java.arguments>-Xmx4096m -Xms2048m -XX:MaxMetaspaceSize=512m --enable-preview</java.arguments>
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <maven.compiler.release>21</maven.compiler.release>
    <maven.compiler.compilerArgs>--enable-preview</maven.compiler.compilerArgs>
</properties>
	<dependencies>
